# ============================================================
# SerenAI Backend - Variables de Entorno (PRODUCCIÓN - Railway)
# ============================================================
# Copia este archivo como .env y completa los valores
# cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# Base de Datos
# Apunta al PostgreSQL del VPS (mismo servidor que N8N)
# Reemplazar IP_DEL_VPS por la IP pública del VPS de Contabo
# ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://serenai:CAMBIAR_POR_PASSWORD_SEGURO@IP_DEL_VPS:5432/sereneia_users

# ------------------------------------------------------------
# JWT - Generar con: openssl rand -base64 32
# NUNCA usar el valor de desarrollo en producción
# ------------------------------------------------------------
JWT_SECRET_KEY=GENERAR_CON_openssl_rand_base64_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------
# N8N Webhook
# Reemplazar IP_DEL_VPS por la IP pública del VPS de Contabo
# El path del webhook se obtiene de N8N → Settings → Webhook URL
# ------------------------------------------------------------
N8N_BASE_URL=http://IP_DEL_VPS:5678
N8N_WEBHOOK_PATH=/webhook/0d9040d7-6c66-48b7-8ccd-914e8ddfa6a9
N8N_API_KEY=JyIZSgvPnfV8damYtp8tXzP+Jl1yarQL6916tTT7jzs=
N8N_TIMEOUT_SECONDS=120

# ------------------------------------------------------------
# CORS - URL del frontend en Vercel
# Actualizar con la URL real después de desplegar en Vercel
# ------------------------------------------------------------
CORS_ORIGINS=["https://TU-APP.vercel.app"]

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
DEBUG=false
APP_NAME=SerenAI Backend
APP_VERSION=1.0.0
