# ============================================================
# SerenAI ChatBot - Variables de Entorno (PRODUCCIÓN - VPS)
# ============================================================
# Copia este archivo como .env y completa los valores
# cp .env.example .env
# ============================================================

# ------------------------------------------------------------------
# PostgreSQL - Credenciales del servidor de base de datos
# IMPORTANTE: Cambiar usuario y contraseña por valores seguros
# ------------------------------------------------------------------
POSTGRES_USER=serenai
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
POSTGRES_DB=n8n

# ------------------------------------------------------------------
# Conexión N8N → PostgreSQL (usa las variables de arriba)
# ------------------------------------------------------------------
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_USER=${POSTGRES_USER}
DB_POSTGRESDB_PASSWORD=${POSTGRES_PASSWORD}
DB_POSTGRESDB_DATABASE=${POSTGRES_DB}
DB_POSTGRESDB_PORT=5432

# ------------------------------------------------------------------
# N8N - Seguridad
# IMPORTANTE: Esta clave encripta las credenciales guardadas en N8N.
# NO cambiar después del primer inicio o las credenciales se pierden.
# Valor actual (local): M/ASP72+AYG27fC17B0xN6LjWZ/ButRF
# Para nueva instalación limpia dejar vacío (N8N genera una automáticamente)
# ------------------------------------------------------------------
N8N_ENCRYPTION_KEY=

# ------------------------------------------------------------------
# N8N - URL pública del servidor (necesaria para webhooks)
# Reemplazar con la IP o dominio real del VPS
# Ejemplo: http://123.456.789.0:5678 o https://n8n.tu-dominio.com
# ------------------------------------------------------------------
N8N_WEBHOOK_URL=http://IP_DEL_VPS:5678
N8N_EDITOR_BASE_URL=http://IP_DEL_VPS:5678

# ------------------------------------------------------------------
# N8N - Configuración
# ------------------------------------------------------------------
N8N_RUNNERS_ENABLED=true
N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_BASIC_AUTH_ACTIVE=true

# ------------------------------------------------------------------
# N8N - Límites de ejecución
# ------------------------------------------------------------------
N8N_WORKFLOW_RUN_TIMEOUT=3600
N8N_CONCURRENCY_MAIN=10
N8N_MAX_EXECUTION_TIME=3600

# ------------------------------------------------------------------
# Permisos de funciones de Node.js en N8N
# ------------------------------------------------------------------
NODE_FUNCTION_ALLOW_BUILTIN=*
NODE_FUNCTION_ALLOW_EXTERNAL=*
NODE_FUNCTION_ALLOW_CUSTOM=*

# ------------------------------------------------------------------
# Configuración general
# ------------------------------------------------------------------
GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota

# ------------------------------------------------------------------
# Puertos (cambiar solo si hay conflicto)
# ------------------------------------------------------------------
N8N_PORT=5678
QDRANT_PORT=6333
